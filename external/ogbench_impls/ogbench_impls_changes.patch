+# =============================================================================
+# LeWM latent environment wrapper
+# =============================================================================
+
+class LeWMLatentWrapper(gymnasium.Wrapper):
+    """Wraps swm/OGBCube-v0 to return 192-D LeWM encoder latents as observations.
+
+    Actions are 25-D (5 physical steps × 5-D, StandardScaler-normalised),
+    matching the WM-step granularity of lewm_latent_dataset.npz.
+    One call to step() internally executes 5 consecutive physical actions.
+
+    Args:
+        env:            Unwrapped swm/OGBCube-v0 gymnasium env.
+        encode_fn:      Callable (H, W, 3) uint8 → (192,) float32 numpy array.
+        action_scaler:  sklearn StandardScaler fit on raw 5-D dataset actions.
+    """
+
+    def __init__(self, env, encode_fn, action_scaler):
+        super().__init__(env)
+        self.encode_fn      = encode_fn
+        self.action_scaler  = action_scaler
+        self.observation_space = Box(-np.inf, np.inf, shape=(192,), dtype=np.float32)
+        # 25-D normalised; the eval loop may clip to [-1,1] — inverse_transform still works
+        self.action_space = Box(-5.0, 5.0, shape=(25,), dtype=np.float32)
+
+    def _encode(self, obs_hwc):
+        return self.encode_fn(obs_hwc)
+
+    def reset(self, **kwargs):
+        obs, info = self.env.reset(**kwargs)
+        if "target" in info:
+            info["goal"] = self._encode(info["target"])
+        return self._encode(obs), info
+
+    def step(self, action_25d):
+        """Expand one 25-D normalised action into 5 physical env steps."""
+        raw      = np.array(action_25d).reshape(5, 5)
+        physical = np.clip(self.action_scaler.inverse_transform(raw), -1.0, 1.0)
+        obs = terminated = truncated = None
+        reward = 0.0
+        info   = {}
+        for t in range(5):
+            obs, reward, terminated, truncated, info = self.env.step(physical[t])
+            if terminated or truncated:
+                break
+        return self._encode(obs), reward, terminated, truncated, info
+
+
+def make_latent_env_and_datasets(latent_dataset_path, encode_fn, action_scaler_path,
+                                  frame_stack=None):
+    """Load a LeWM latent dataset and wrap swm/OGBCube-v0 for evaluation.
+
+    Args:
+        latent_dataset_path:  Path to lewm_latent_dataset.npz.
+        encode_fn:            Callable (H,W,3) uint8 → (192,) float32 numpy.
+                              Build this from the frozen LeWM encoder in your training script.
+        action_scaler_path:   Path to lewm_action_scaler.npz.
+        frame_stack:          Ignored (latent obs are already temporal aggregates).
+
+    Returns:
+        (env, train_dataset, val_dataset)  — env is a LeWMLatentWrapper.
+    """
+    from sklearn.preprocessing import StandardScaler
+
+    # Reconstruct action scaler from saved params
+    sc = np.load(action_scaler_path)
+    action_scaler = StandardScaler()
+    action_scaler.mean_           = sc["mean"]
+    action_scaler.scale_          = sc["scale"]
+    action_scaler.n_features_in_  = int(len(sc["mean"]))
+
+    # Build eval env
+    raw_env = gymnasium.make("swm/OGBCube-v0", ob_type="pixels",
+                              env_type="single", visualize_info=False)
+    env = LeWMLatentWrapper(raw_env, encode_fn, action_scaler)
+    env.reset()
+
+    # Load dataset
+    data = np.load(latent_dataset_path)
+    train_dataset = Dataset.create(
+        observations = data["train_observations"],
+        actions      = data["train_actions"],
+        terminals    = data["train_terminals"],
+        rewards      = data["train_rewards"],
+        valids       = data["train_valids"],
+    )
+    val_dataset = Dataset.create(
+        observations = data["val_observations"],
+        actions      = data["val_actions"],
+        terminals    = data["val_terminals"],
+        rewards      = data["val_rewards"],
+        valids       = data["val_valids"],
+    )
+
+    return env, train_dataset, val_dataset
+
+
