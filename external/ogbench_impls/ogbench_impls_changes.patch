+def evaluate_hier_chunked(
+    agent,
+    env,
+    task_id=None,
+    config=None,
+    num_eval_episodes=50,
+    num_video_episodes=0,
+    video_frame_skip=3,
+    eval_temperature=0,
+    eval_gaussian=None,
+):
+    """Evaluate a hierarchical action-chunking agent.
+
+    The high-level actor proposes a subgoal representation every ``subgoal_steps``
+    env steps; the low-level flow actor emits an ``action_chunk_len``-step chunk
+    that is executed open-loop via an action queue, refilled when empty. This is
+    the HIQL hierarchy at the subgoal cadence + ACFQL's chunked execution.
+    """
+    high_rng = jax.random.PRNGKey(np.random.randint(0, 2**32))
+    low_rng = jax.random.PRNGKey(np.random.randint(0, 2**32))
+
+    subgoal_steps = config['subgoal_steps']
+    action_dim = config['action_dim']
+    chunk_len = config['action_chunk_len']
+
+    trajs = []
+    stats = defaultdict(list)
+    renders = []
+    for i in trange(num_eval_episodes + num_video_episodes):
+        traj = defaultdict(list)
+        should_render = i >= num_eval_episodes
+
+        observation, info = env.reset(options=dict(task_id=task_id, render_goal=should_render))
+        goal = info.get('goal')
+        goal_frame = info.get('goal_rendered')
+        done = False
+        step = 0
+        render = []
+
+        goal_rep = None
+        action_queue = []
+        while not done:
+            # Refresh subgoal representation at the HL cadence.
+            if step % subgoal_steps == 0:
+                high_rng, hkey = jax.random.split(high_rng)
+                goal_rep = agent.sample_high_rep(
+                    observations=observation, goals=goal, seed=hkey, temperature=eval_temperature
+                )
+                action_queue = []  # force a fresh chunk under the new subgoal
+
+            # Refill the action queue with a fresh chunk when empty.
+            if len(action_queue) == 0:
+                low_rng, lkey = jax.random.split(low_rng)
+                chunk = agent.sample_low_chunk(
+                    observations=observation, goal_reps=goal_rep, seed=lkey, temperature=eval_temperature
+                )
+                chunk = np.array(chunk).reshape(-1, action_dim)  # (chunk_len, action_dim)
+                action_queue = list(chunk)
+
+            action = action_queue.pop(0)
+            if eval_gaussian is not None:
+                action = np.random.normal(action, eval_gaussian)
+            action = np.clip(action, -1, 1)
+
+            next_observation, reward, terminated, truncated, info = env.step(action)
+            done = terminated or truncated
+            step += 1
+
+            if should_render and (step % video_frame_skip == 0 or done):
+                frame = env.render().copy()
+                if goal_frame is not None:
+                    render.append(np.concatenate([goal_frame, frame], axis=0))
+                else:
+                    render.append(frame)
+
+            transition = dict(
+                observation=observation,
+                next_observation=next_observation,
+                action=action,
+                reward=reward,
+                done=done,
+                info=info,
+            )
+            add_to(traj, transition)
+            observation = next_observation
+        if i < num_eval_episodes:
+            add_to(stats, flatten(info))
+            trajs.append(traj)
+        else:
+            renders.append(np.array(render))
+
+    for k, v in stats.items():
+        stats[k] = np.mean(v)
+
+    return stats, trajs, renders
+
+
